{
  "name": "meetingid",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm test",
    "demo": "node scripts/demo/start.mjs",
    "demo:live": "node scripts/demo/start.mjs --live",
    "demo:tunnel": "node scripts/demo/tunnel.mjs",
    "demo:check": "npm run demo:check -w @meetingid/api",
    "demo:snapshot": "npm run demo:snapshot -w @meetingid/api",
    "demo:reset": "npm run demo:reset -w @meetingid/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "eslint": "^9.19.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^15.14.0",
    "localtunnel": "^2.0.2",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.71.0"
  }
}
