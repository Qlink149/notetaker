# MeetingID — copy to .env at the repo root and fill in. Never commit .env.
# The api (Render web service) and worker (Render background worker) read the same variables;
# the "who needs it" column is in README.md.

# --- Core (api + worker) ---
NODE_ENV=development
# MongoDB Atlas connection string (database name in the path, e.g. /meetingid)
MONGODB_URI=
# Random string, at least 32 characters. Signs login tokens.
JWT_SECRET=
# Shared login code for the seeded "Kisna" workspace (min 6 chars). Used by `npm run seed`.
WORKSPACE_ACCESS_CODE=
# Comma-separated browser origins allowed to call the API (the Vercel URL). localhost:5173 is always allowed.
CORS_ORIGINS=
LOG_LEVEL=info

# --- Storage: Cloudinary (api + worker) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Engines (worker; api only for deletes/enrolment) ---
# Google AI Studio key for Gemini (primary transcription engine, Files API)
GEMINI_API_KEY=
# Model ids; change only after checking the Gemini docs
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
# Deepgram (fallback engine behind the workspace switch, and benchmark)
DEEPGRAM_API_KEY=
# Anthropic (summaries with Claude Haiku 4.5)
ANTHROPIC_API_KEY=
# pyannoteAI (speaker enrolment now; voiceprint matching in Phase 2) — api only
PYANNOTEAI_API_KEY=
# Optional: Sarvam AI (Phase 2 benchmark only)
SARVAM_API_KEY=
# Optional: unused in Phase 1, kept from the Base44 app
OPENAI_API_KEY=

# --- Worker tuning (optional) ---
# Stable id for this worker instance (defaults to hostname-pid)
WORKER_ID=
# Jobs run in parallel per worker process (1-8)
WORKER_CONCURRENCY=2
# Override the bundled ffmpeg/ffprobe binaries (e.g. a system ffmpeg in Docker)
FFMPEG_PATH=
FFPROBE_PATH=

RENDER_API_KEY
