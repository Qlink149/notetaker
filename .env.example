# MeetingID — copy to .env at the repo root and fill in. Never commit .env.
# The api (Render web service) and worker (Render background worker) read the same variables;
# the "who needs it" column is in README.md.

# --- Core (api + worker) ---
NODE_ENV=development
# MongoDB Atlas connection string (database name in the path, e.g. /meetingid)
MONGODB_URI=
# Random string, at least 32 characters. Signs login tokens.
JWT_SECRET=
# Shared login code for the seeded "Kisna" workspace (min 6 chars). Used by `npm run seed`.
WORKSPACE_ACCESS_CODE=
# Comma-separated browser origins allowed to call the API (the Vercel URL). localhost:5173 is always allowed.
CORS_ORIGINS=
LOG_LEVEL=info

# --- Storage: where recordings are kept (api + worker) ---
# cloudinary (the original setup) | b2 (Backblaze B2, private bucket, S3-compatible).
# With b2, new recordings go to B2; meetings made earlier on Cloudinary keep working, so keep the
# CLOUDINARY_* values while any exist.
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Backblaze B2 (needed when STORAGE_PROVIDER=b2). Create a PRIVATE bucket and an application key limited
# to it (read and write). Backblaze shows these on the key's page:
#   B2_ENDPOINT          the bucket's S3 endpoint, e.g. https://s3.us-west-004.backblazeb2.com
#   B2_REGION            the region in that endpoint, e.g. us-west-004
#   B2_BUCKET            the bucket name
#   B2_KEY_ID            the application key's "keyID"
#   B2_APPLICATION_KEY   the application key itself (shown once when created)
B2_ENDPOINT=
B2_REGION=
B2_BUCKET=
B2_KEY_ID=
B2_APPLICATION_KEY=
# The API's own public address (https://...), no trailing slash. Builds the signed audio playback links.
# e.g. https://meetingid-phase2.onrender.com (locally: http://localhost:8080)
PUBLIC_API_URL=

# --- Engines (worker; api only for deletes/enrolment) ---
# Google AI Studio key(s) for Gemini (primary transcription engine, Files API).
# Several keys may be given as GEMINI_API_KEY1..GEMINI_API_KEY9; a key that hits its daily quota
# is skipped until Google's reset (tracked in MongoDB).
GEMINI_API_KEY=
# The paid Gemini key (billing on). Used before the others. When it is set, Gemini spend counts against SPEND_CAP_USD.
# List the free-tier keys in GEMINI_FREE_KEYS so client recordings never go through them.
GEMINI_PAID_API_KEY=
GEMINI_API_KEY1=
GEMINI_API_KEY2=
GEMINI_API_KEY3=
# Names (comma separated) of the keys above that are on Google's FREE tier, e.g. GEMINI_API_KEY1,GEMINI_API_KEY2.
# Google may use free-tier content to improve its products and humans may read it, so these keys are NOT
# used on recordings. Leave empty when every key is paid.
GEMINI_FREE_KEYS=
# true = use the free keys anyway (demos and tests with non-client audio only)
GEMINI_ALLOW_FREE_KEYS=false
# Model ids; change only after checking the Gemini docs
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
# Tried once when the primary is overloaded or out of quota on every key ("none" disables)
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
# true when the Gemini keys are on a paid tier (then Gemini spend counts against the cap)
GEMINI_PAID=false

# Who writes summaries: anthropic (production) | handoff (testing: an external agent answers, no API spend)
SUMMARY_PROVIDER=anthropic

# --- Spending cap ---
# Hard cap in USD on Claude (+ Gemini when paid) spend across all meetings and benchmarks. Deepgram is not capped.
SPEND_CAP_USD=5
# Database name used when MONGODB_URI has none in its path
MONGODB_DB=meetingid
# Deepgram (fallback engine behind the workspace switch, and benchmark)
DEEPGRAM_API_KEY=
# Anthropic (summaries with Claude Haiku 4.5)
ANTHROPIC_API_KEY=
# pyannoteAI: voice analysis (who speaks when) and voiceprint matching
PYANNOTEAI_API_KEY=
# Optional second pyannote account used ONLY for voiceprints (the request, the clip upload and the job
# polling all use it). Set it when the main account has no voiceprint allowance left.
PYANNOTEAI_VOICEPRINT_API_KEY=
# Optional: Sarvam AI (Phase 2 benchmark only)
SARVAM_API_KEY=
# Optional: unused in Phase 1, kept from the Base44 app
OPENAI_API_KEY=

# --- Worker tuning (optional) ---
# Stable id for this worker instance (defaults to hostname-pid)
WORKER_ID=
# Jobs run in parallel per worker process (1-8)
WORKER_CONCURRENCY=2
# Chunks transcribed at once, on a separate lane (0 = no separate lane). They only wait on Gemini, so they are cheap on memory.
WORKER_TRANSCRIBE_CONCURRENCY=4
# Most Gemini requests in flight at once from one worker, whichever stage sends them (rate-limit guard).
GEMINI_MAX_CONCURRENT=6
# true = the worker also listens on PORT with GET /health, so it can run as a Render web service
WORKER_HTTP=false
# Override the bundled ffmpeg/ffprobe binaries (e.g. a system ffmpeg in Docker)
FFMPEG_PATH=
FFPROBE_PATH=

# --- Deployment tooling (not read by the app) ---
# Render API key, used only by scripts that create or deploy services
RENDER_API_KEY=
# A second Render workspace's key (its own 750 free hours): the worker can run there as a free web service
RENDER_API_KEY2=
