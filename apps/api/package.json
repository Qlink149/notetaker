{
  "name": "@meetingid/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=source --env-file-if-exists=../../.env src/server.ts",
    "dev:worker": "tsx watch --conditions=source --env-file-if-exists=../../.env src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "seed": "tsx --conditions=source --env-file-if-exists=../../.env src/scripts/seed.ts",
    "eval": "tsx --conditions=source --env-file-if-exists=../../.env src/scripts/eval.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "probe": "tsx --conditions=source src/scripts/probe-files.ts",
    "handoff": "tsx --conditions=source --env-file-if-exists=../../.env src/scripts/handoff.ts",
    "acceptance": "tsx --conditions=source --env-file-if-exists=../../.env src/scripts/acceptance.ts",
    "start:all": "node dist/all.js",
    "dev:all": "tsx watch --conditions=source --env-file-if-exists=../../.env src/all.ts",
    "reassemble": "tsx --conditions=source --env-file-if-exists=../../.env src/scripts/reassemble.ts",
    "requeue": "tsx --conditions=source --env-file-if-exists=../../.env src/scripts/requeue.ts",
    "p2:diarize": "tsx --conditions=source --env-file-if-exists=../../.env src/scripts/phase2/diarize.ts",
    "p2:stats": "tsx --conditions=source --env-file-if-exists=../../.env src/scripts/phase2/stats.ts",
    "demo:copy": "tsx --conditions=source --env-file-if-exists=../../.env src/scripts/demo/copyDb.ts",
    "p2:deepgram": "tsx --conditions=source --env-file-if-exists=../../.env src/scripts/phase2/deepgram.ts",
    "p2:join": "tsx --conditions=source --env-file-if-exists=../../.env src/scripts/phase2/join.ts",
    "p2:joincheck": "tsx --conditions=source --env-file-if-exists=../../.env src/scripts/phase2/joinCheck.ts",
    "p2:holdout": "tsx --conditions=source --env-file-if-exists=../../.env src/scripts/phase2/holdout.ts",
    "p2:identity": "tsx --conditions=source --env-file-if-exists=../../.env src/scripts/phase2/identity.ts",
    "p2:audit-seed": "tsx --conditions=source --env-file-if-exists=../../.env src/scripts/phase2/auditSeed.ts",
    "p2:migrate-key-labels": "tsx --conditions=source --env-file-if-exists=../../.env src/scripts/phase2/migrateKeyLabels.ts",
    "demo:prepare": "tsx --conditions=source --env-file-if-exists=../../.env src/scripts/demo/prepare.ts",
    "demo:reprocess": "tsx --conditions=source --env-file-if-exists=../../.env src/scripts/demo/reprocess.ts",
    "demo:synthetic-phones": "tsx --conditions=source --env-file-if-exists=../../.env src/scripts/demo/syntheticPhones.ts",
    "demo:check": "tsx --conditions=source --env-file-if-exists=../../.env src/scripts/demo/check.ts",
    "demo:snapshot": "tsx --conditions=source --env-file-if-exists=../../.env src/scripts/demo/snapshot.ts",
    "demo:reset": "tsx --conditions=source --env-file-if-exists=../../.env src/scripts/demo/reset.ts",
    "demo:refresh": "tsx --conditions=source --env-file-if-exists=../../.env src/scripts/demo/refresh.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@google/genai": "^2.24.0",
    "@meetingid/pipeline": "0.1.0",
    "@meetingid/shared": "0.1.0",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "docx": "^9.8.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.2",
    "multer": "^2.4.0",
    "pino": "^10.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.13.5",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "vitest": "^3.2.4"
  }
}
